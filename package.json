{
  "name": "actos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "ACTOS — GitHub Actions as an operating system: async pages, object store, cached runs, agentic harness.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "seed": "npx tsx src/db/seed.ts",
    "agent": "npx tsx src/cli/agent.ts",
    "drain": "npx tsx src/cli/agent.ts --drain",
    "fs:init": "npx tsx src/cli/fs-sync.ts --init",
    "fs:push": "npx tsx src/cli/fs-sync.ts --push",
    "gc": "npx tsx src/cli/gc.ts --promote",
    "cdn:export": "npx tsx src/cli/cdn-export.ts",
    "test": "node --import tsx --test src/domain/*.test.ts src/invariants.test.ts",
    "session-notice": "npx tsx src/cli/inject-session-notice.ts",
    "loop": "bash scripts/loop-action.sh",
    "plugin:install": "bash plugin/actos/install.sh"
  },
  "dependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
